# ========================================
# Employee Payroll & Workforce Management
# Environment Variables
# ========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# --- Spring Profile ---
# Set to 'dev' for local development, 'prod' for production
SPRING_PROFILES_ACTIVE=dev

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/payroll_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# --- JWT ---
JWT_SECRET=your_64_character_secret_here
JWT_EXPIRATION_MS=86400000

# --- Mail (Gmail SMTP) ---
# Set MAIL_ENABLED to true if you want to send actual emails.
# If false, emails (like OTPs and password resets) will be logged to the console/log file instead.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost,http://localhost:80

# --- Admin Seed (first-run only) ---
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FULL_NAME=System Administrator
ADMIN_EMPLOYEE_CODE=ADM001

# --- Upload Directories ---
PROFILE_UPLOAD_DIR=uploads/profile
PAYSLIP_UPLOAD_DIR=uploads/payslips
# Touch to update git timestamp